{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-app",
  "main": "worker.js",
  "compatibility_date": "2026-05-22",
  "assets": { "directory": "dist", "not_found_handling": "single-page-application" },
  "observability": { "enabled": true },
  "compatibility_flags": ["nodejs_compat"]
}
